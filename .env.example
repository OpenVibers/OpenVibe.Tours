# OpenVibe.Tours — copy to /etc/openvibe/tours.env in production; never commit the real file.
NODE_ENV=production
PORT=5170
HOST=127.0.0.1
BASE_URL=https://openvibe.tours

# PostgreSQL (ADR-035): DATABASE_URL serves, DATABASE_DIRECT_URL migrates with the owner role.
DATABASE_URL=postgres://openvibe_tours:CHANGE_ME@127.0.0.1:6432/openvibe_tours
DATABASE_DIRECT_URL=postgres://openvibe_tours:CHANGE_ME@127.0.0.1:5432/openvibe_tours
VALKEY_URL=redis://127.0.0.1:6379
VALKEY_PREFIX=ov:tours:

# OpenVibe.Network: OAuth client tours + the session JWKS.
OV_NETWORK_URL=https://openvibe.network
OV_NETWORK_INTERNAL_URL=http://127.0.0.1:4000
OV_NETWORK_ISSUER=https://openvibe.network
OV_OAUTH_CLIENT_ID=tours
OV_OAUTH_CLIENT_SECRET=
OV_OAUTH_REDIRECT_URI=https://openvibe.tours/auth/callback
OV_SESSION_AUDIENCE=openvibe.network
TOURS_AUDIENCE=openvibe.tours
COOKIE_SECURE=true

# Account export/deletion delivery from OpenVibe.Events (32+ chars, comma-separated for rotation).
TOURS_EVENTS_SECRET=
TOURS_EVENTS_URL=https://openvibe.events
TOURS_EVENTS_ENDPOINT=
TOURS_EVENTS_SCOPE=events.subscription.manage

# The public APIs and open data the jobs read (all keyless).
OV_LIVE_URL=https://openvibe.live
OV_LIVE_PUBLIC_URL=https://openvibe.live
OV_VIDEO_PUBLIC_URL=https://openvibe.video
OV_RENT_URL=https://openvibe.rent
OV_RENT_PUBLIC_URL=https://openvibe.rent
OV_WIKIVOYAGE_URL=https://en.wikivoyage.org
OV_WIKIDATA_URL=https://www.wikidata.org
OV_WIKIPEDIA_URL=https://en.wikipedia.org
OV_COMMONS_URL=https://commons.wikimedia.org
OV_OVERPASS_URL=https://overpass-api.de/api/interpreter

# Identify every OpenStreetMap request; pace each host; bound each city query by radius.
TOURS_USER_AGENT=OpenVibeTours/0.1 (+https://openvibe.tours; contact@openvibe.network)
TOURS_OSM_EMAIL=
TOURS_MIN_INTERVAL_MS=1100
TOURS_OSM_RADIUS_M=3500
TOURS_OSM_MAX_PER_CITY=80
TOURS_CITY_LIMIT=100
TOURS_WIKIVOYAGE_DISTRICTS=2
TOURS_UPSTREAM_TIMEOUT_MS=60000
TOURS_OSM_CITIES_PER_RUN=10

# Source jobs: off under TOURS_DRILL; each has its own refresh interval.
TOURS_JOBS=on
TOURS_JOBS_INTERVAL_MS=21600000
TOURS_CITIES_INTERVAL_MS=86400000
TOURS_PLACES_INTERVAL_MS=604800000
TOURS_ROUTES_INTERVAL_MS=604800000
TOURS_LIVE_INTERVAL_MS=120000
TOURS_STAYS_INTERVAL_MS=21600000

# Flights: no key in v1. The form links the official airline-neutral search. A key alone leaves the seam off until
# an adapter exists; never put a real key in this file in git.
TOURS_FLIGHTS_SEARCH_URL=https://www.google.com/travel/flights
TOURS_DUFFEL_API_KEY=
TOURS_KIWI_API_KEY=

# Limits.
TOURS_RATE_LIMIT_PER_MIN=300
TOURS_API_RATE_LIMIT_PER_MIN=240
TOURS_LIMITS_MINUTE=120
TOURS_LIMITS_HOUR=3000

# Development only: embedded PGlite directory when DATABASE_URL is unset.
TOURS_PGLITE_DIR=
